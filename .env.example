# Arquivo de exemplo de variáveis de ambiente - Pontinho UFABC
# Copie este arquivo para .env e defina chaves seguras em produção:
# cp .env.example .env

# Chave secreta obrigatória para assinatura de tokens de sessão HMAC-SHA256 (mínimo 32 caracteres)
PONTINHO_SECRET_KEY=substitua_por_uma_chave_criptografica_forte_de_pelo_menos_32_caracteres

# Caminho do banco SQLite (padrão em container Docker)
DATABASE_PATH=/app/data/pontinho.db
