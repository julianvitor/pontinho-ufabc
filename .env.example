# Arquivo de exemplo de variáveis de ambiente - Pontinho UFABC
# Copie este arquivo para .env e defina chaves seguras em produção:
# cp .env.example .env

# Chave secreta obrigatória para assinatura de tokens de sessão HMAC-SHA256 (mínimo 32 caracteres)
PONTINHO_SECRET_KEY=substitua_por_uma_chave_criptografica_forte_de_pelo_menos_32_caracteres

# Caminho do banco SQLite (padrão em container Docker)
DATABASE_PATH=/app/data/pontinho.db

# Modo de desenvolvimento (habilita endpoints de apoio como /api/auth/demo-accounts)
# Em produção, mantenha SEMPRE false
DEV_MODE=true

# Atributo Secure para Cookies de Sessão (true para HTTPS em produção, false para HTTP local)
SECURE_COOKIES=false

# Origens permitidas no CORS separadas por vírgula (ex: https://meusite.com,https://app.com)
CORS_ORIGINS=https://pontinho-ufabc.julian-vtr.workers.dev,https://*.workers.dev,https://*.pages.dev,https://*.julianvitor.com.br,https://julianvitor.com.br

# Serviço de Envio de E-mails (Resend.com)
RESEND_API_KEY=re_sua_chave_do_resend_aqui
RESEND_FROM_EMAIL=Pontinho UFABC <nao-responda@pontinho.julianvitor.com.br>


# URL base do Frontend (para links de redefinição de senha)
FRONTEND_URL=https://pontinho.julianvitor.com.br
